{
  "name": "gongkao-frontend-open-source",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "predev": "npm run build:packages && node scripts/build-seed.mjs",
    "dev": "vite",
    "build:packages": "npm run build --workspace @gongkao/contracts && npm run build --workspace @gongkao/learning-core",
    "prebuild": "npm run build:packages && node scripts/build-seed.mjs",
    "build": "vue-tsc -b && vite build",
    "pretypecheck": "npm run build:packages",
    "typecheck": "vue-tsc -b",
    "content:update": "npm run build:packages && node scripts/update-content.mjs",
    "test": "npm run build:packages && node --test scripts/*.test.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@gongkao/contracts": "file:packages/contracts",
    "@gongkao/learning-core": "file:packages/learning-core",
    "@phosphor-icons/vue": "^2.2.1",
    "dexie": "^4.4.6",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.7"
  }
}
